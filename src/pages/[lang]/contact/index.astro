---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContactPageBody from '../../../components/contact/ContactPageBody.astro';
import { getMain, localeStaticPaths, localizePath, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = getMain(lang);
const p = t.contact_page;
---
<BaseLayout lang={lang} title={`${t.contact.heading} | ${t.meta.site_name}`} description={p.intro}>
  <PageHero
    lang={lang}
    eyebrow={t.contact.eyebrow}
    title={p.title}
    subtitle={p.intro}
    crumbs={[{ label: t.nav.home, href: localizePath(lang, '/') }, { label: t.nav.contact }]}
  />
  <ContactPageBody lang={lang} />
</BaseLayout>
