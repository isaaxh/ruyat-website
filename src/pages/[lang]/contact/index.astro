---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getMain, localeStaticPaths, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = getMain(lang);
---
<BaseLayout lang={lang} title={`${t.contact.heading} | ${t.meta.site_name}`}>
  <h1>{t.contact.heading}</h1>
  <!-- TODO: build from design/screenshots/*/contact.png (inquiry form → WhatsApp, details, map + directions) -->
</BaseLayout>
