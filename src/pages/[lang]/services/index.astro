---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ServicesBrowser from '../../../components/services/ServicesBrowser.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getMain, getServices, localeStaticPaths, localizePath, type Locale } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = getMain(lang);
const p = getServices(lang).all_services_page;
---
<BaseLayout lang={lang} title={`${p.title} | ${t.meta.site_name}`} description={p.subtitle} active="services">
  <PageHero
    lang={lang}
    eyebrow={p.eyebrow}
    title={p.title}
    subtitle={p.subtitle}
    crumbs={[{ label: t.nav.home, href: localizePath(lang, '/') }, { label: p.eyebrow }]}
  />
  <ServicesBrowser lang={lang} />
  <CtaBand title={p.cta_title} text={p.cta_text} cta={t.nav.contact} href={localizePath(lang, '/contact/')} />
</BaseLayout>
