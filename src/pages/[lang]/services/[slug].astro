---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceHero from '../../../components/services/detail/ServiceHero.astro';
import ServiceDetailBody from '../../../components/services/detail/ServiceDetailBody.astro';
import RelatedServices from '../../../components/services/detail/RelatedServices.astro';
import { LOCALES, getMain, getServices, type Locale, type Service } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    getServices(lang).services.map((service) => ({ params: { lang, slug: service.id }, props: { service } })),
  );
}
const lang = Astro.params.lang as Locale;
const { service } = Astro.props as { service: Service };
---
<BaseLayout lang={lang} title={`${service.title} | ${getMain(lang).meta.site_name}`} description={service.short_description} active="services">
  <ServiceHero lang={lang} service={service} />
  <ServiceDetailBody lang={lang} service={service} />
  <RelatedServices lang={lang} service={service} />
</BaseLayout>
