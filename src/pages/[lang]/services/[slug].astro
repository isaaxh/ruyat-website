---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALES, getMain, getServices, localizePath, type Locale, type Service } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    getServices(lang).services.map((service) => ({ params: { lang, slug: service.id }, props: { service } })),
  );
}
const lang = Astro.params.lang as Locale;
const { service } = Astro.props as { service: Service };
const labels = getServices(lang).service_detail_page;
---
<BaseLayout lang={lang} title={`${service.title} | ${getMain(lang).meta.site_name}`} description={service.short_description}>
  <a href={localizePath(lang, '/services/')}>{labels.back_button}</a>
  <h1>{service.title}</h1>
  <!-- TODO: category tag, hero image, description, what's included, how it works, CTA, related services — from prototype -->
</BaseLayout>
