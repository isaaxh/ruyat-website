---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMain, localeStaticPaths, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = getMain(lang);
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <!-- Section stubs. Build each 1:1 from design/prototype.html. -->
  <section id="hero"><h1>{t.hero.slides[0].title}</h1></section>
  <section id="stats"></section>
  <section id="about"><h2>{t.about.heading}</h2></section>
  <section id="services"></section>
  <section id="why-us"></section>
  <section id="testimonials"></section>
  <section id="faq"></section>
  <section id="contact"><h2>{t.contact.heading}</h2></section>
</BaseLayout>
