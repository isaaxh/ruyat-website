---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import About from '../../components/About.astro';
import ServicesPreview from '../../components/ServicesPreview.astro';
import { getMain, localeStaticPaths, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = Astro.params.lang as Locale;
const t = getMain(lang);
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description} active="home">
  <Hero lang={lang} />
  <Stats lang={lang} />
  <About lang={lang} />
  <ServicesPreview lang={lang} />
</BaseLayout>
