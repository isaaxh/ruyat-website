---
// Office map: keyless Google Maps embed (lazy) in the designed frame, over the prototype's illustrated
// map as a loading placeholder. Optional chip with the place name and a directions link.
import { getMain, type Locale } from '../../i18n';
import { OFFICE, mapsDirectionsUrl, mapsEmbedUrl } from '../../lib/site';

interface Props {
  lang: Locale;
  /** Show the place chip with the Directions button. */
  chip?: boolean;
  class?: string;
}
const { lang, chip = true, class: className } = Astro.props;
const t = getMain(lang).contact.map;
---
<div class:list={['map', className]} data-visual-mask>
  <svg class="illus" viewBox="0 0 342 220" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect x="0" y="0" width="342" height="220" fill="#ece5d6"></rect>
    <g fill="#e1d7c2">
      <rect x="8" y="8" width="42" height="40" rx="4"></rect><rect x="82" y="6" width="56" height="34" rx="4"></rect><rect x="170" y="2" width="62" height="26" rx="4"></rect><rect x="262" y="44" width="70" height="30" rx="4"></rect>
      <rect x="10" y="78" width="46" height="52" rx="4"></rect><rect x="84" y="80" width="50" height="40" rx="4"></rect><rect x="168" y="66" width="56" height="44" rx="4"></rect><rect x="262" y="104" width="68" height="40" rx="4"></rect>
      <rect x="12" y="166" width="44" height="34" rx="4"></rect><rect x="92" y="160" width="40" height="36" rx="4"></rect><rect x="170" y="150" width="50" height="36" rx="4"></rect><rect x="256" y="160" width="74" height="22" rx="4"></rect>
    </g>
    <g fill="none" stroke="#ffffff" stroke-linecap="round">
      <path d="M-10 66 L352 98" stroke-width="7"></path><path d="M40 -10 L72 230" stroke-width="6"></path><path d="M246 -10 L232 230" stroke-width="7"></path>
      <path d="M-10 204 L352 190" stroke-width="6"></path><path d="M120 -10 L152 230" stroke-width="12"></path><path d="M-10 150 C 80 140, 170 112, 352 62" stroke-width="16"></path>
    </g>
    <path d="M-10 32 C 100 44, 220 22, 352 12" fill="none" stroke="#e9cf9f" stroke-width="10" stroke-linecap="round"></path>
  </svg>
  <iframe
    class="frame"
    title={t.title}
    src={mapsEmbedUrl(OFFICE.lat, OFFICE.lng, lang)}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  {chip && (
    <div class="chip">
      <span class="place">
        <span class="name">{t.place}</span>
        <span class="street">{t.street}</span>
      </span>
      <a class="go" href={mapsDirectionsUrl(OFFICE.lat, OFFICE.lng)} target="_blank" rel="noopener">{t.directions}</a>
    </div>
  )}
</div>

<style>
  .map { position: relative; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-card); background: var(--map-paper); }
  .illus { position: absolute; inset: 0; width: 100%; height: 100%; }
  .frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .chip {
    position: absolute; inset-inline: var(--space-3); bottom: var(--space-3);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
    background: var(--white); border-radius: var(--radius-menu); padding: 10px; padding-inline-start: var(--space-4);
    box-shadow: var(--shadow-chip);
  }
  .place { min-width: 0; }
  .name { display: block; color: var(--ink); font-size: 15px; font-weight: 700; line-height: 1.4; }
  .street { display: block; color: var(--ink-muted); font-size: 13px; font-weight: 500; line-height: 1.5; }
  .go {
    flex: none; display: inline-flex; align-items: center; min-height: var(--size-tap); padding: 0 18px;
    border-radius: var(--radius-pill); background: var(--navy-900); color: var(--gold-400); text-decoration: none;
    font-size: 15px; font-weight: 700; line-height: 1.4;
  }
  .go:hover { background: var(--navy-600); color: var(--gold-200); }
</style>
