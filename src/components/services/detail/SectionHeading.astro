---
// Section heading of the service detail body: h2 plus the gold rule. `mobileHidden` keeps it for screen readers only on phones.
interface Props {
  text: string;
  mobileHidden?: boolean;
}
const { text, mobileHidden = false } = Astro.props;
---
<div class:list={['sec-head', { 'mobile-hidden': mobileHidden }]}>
  <h2 class="sec-title">{text}</h2>
  <div class="rule"></div>
</div>

<style>
  .sec-title { color: var(--ink); font-size: 22px; font-weight: 700; line-height: 1.3; }
  .rule { margin: var(--space-3) 0 var(--space-5); }
  :lang(ar) .sec-title { font-size: 24px; line-height: 1.35; }
  .mobile-hidden .sec-title {
    position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .mobile-hidden .rule { display: none; }

  @media (min-width: 641px) {
    .sec-title { font-size: 26px; }
    :lang(ar) .sec-title { font-size: 26px; line-height: 1.5; }
    .rule { margin: var(--space-3) 0 22px; }
    .mobile-hidden .sec-title { position: static; width: auto; height: auto; margin: 0; overflow: visible; clip: auto; white-space: normal; }
    .mobile-hidden .rule { display: block; }
  }
  @media (min-width: 1024px) {
    .rule { width: 200px; margin: 14px 0 var(--space-6); }
    :lang(ar) .sec-title { font-size: 30px; line-height: 1.45; }
  }
</style>
