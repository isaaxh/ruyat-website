---
// Related service link: a white row with icon tile and chevron on phones, a navy card with ribbons from tablet.
import { localizePath, type Locale, type Service } from '../../../i18n';
import { SERVICE_ICONS } from '../../../lib/serviceIcons';

interface Props {
  lang: Locale;
  service: Service;
}
const { lang, service } = Astro.props;
---
<a class="rel-card" href={localizePath(lang, `/services/${service.id}/`)}>
  <span class="rib r1" style="--rot:-35deg"></span>
  <span class="rib r2" style="--rot:-35deg"></span>
  <span class="tile">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d={SERVICE_ICONS[service.id]}></path></svg>
  </span>
  <span class="text">
    <span class="title t-h3">{service.title}</span>
    <span class="desc">{service.short_description}</span>
  </span>
  <svg class="chev" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</a>

<style>
  .rel-card {
    position: relative; display: flex; align-items: center; gap: var(--space-4); width: 100%; min-height: 88px; box-sizing: border-box;
    padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--white);
    text-align: start; text-decoration: none; color: var(--ink);
    transition: box-shadow var(--duration-fast) ease, background var(--duration-fast) ease;
  }
  .rel-card:hover { color: var(--ink); box-shadow: var(--shadow-card); }
  .rel-card:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .rib { display: none; }
  .tile {
    flex: none; width: 52px; height: 52px; border-radius: var(--radius-menu); background: var(--navy-900);
    display: flex; align-items: center; justify-content: center;
  }
  .icon { width: 28px; height: 28px; fill: none; stroke: var(--gold-400); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .text { flex: 1; min-width: 0; }
  .title { display: block; color: var(--ink); }
  :lang(ar) .title { line-height: 1.35; }
  .desc { display: block; margin-top: var(--space-1); color: var(--ink-muted); font-size: 13px; font-weight: 500; line-height: 1.5; }
  :lang(ar) .desc { line-height: 1.6; }
  .chev { flex: none; width: 16px; height: 16px; color: var(--accent); }
  :global([dir='rtl']) .chev { transform: scaleX(-1); }

  @media (min-width: 641px) {
    .rel-card {
      display: block; height: 230px; min-height: 0; padding: 0; border: 0; border-radius: var(--radius-lg);
      overflow: hidden; background: var(--navy-900); color: var(--white);
    }
    .rel-card:hover { color: var(--white); box-shadow: none; background: var(--navy-800); }
    .rib { display: block; width: 300px; }
    .r1 { inset-inline-end: -80px; top: 124px; opacity: 0.85; }
    .r2 { inset-inline-end: -60px; top: 154px; opacity: 0.35; }
    .tile { position: absolute; top: 22px; inset-inline-end: var(--space-6); width: 58px; height: 58px; border-radius: 0; background: none; }
    .icon { width: 58px; height: 58px; stroke-width: 1.3; }
    .text { position: absolute; inset-inline: 22px; bottom: var(--space-5); }
    .title { color: var(--white); }
    :lang(ar) .title { line-height: 1.45; }
    .desc { margin-top: 5px; color: var(--on-navy-muted); }
    .chev { display: none; }
  }
  @media (min-width: 1024px) {
    .rel-card:hover { background: var(--navy-900); box-shadow: var(--shadow-svc-hover); }
    /* The Arabic desktop reference draws these cards taller. */
    .rel-card:lang(ar) { height: 240px; }
    .r1 { inset-inline-end: -120px; top: 104px; }
    .r2 { inset-inline-end: -98px; top: 134px; }
    .tile {
      top: var(--space-5); inset-inline-end: var(--space-5); width: 74px; height: 74px; box-sizing: border-box;
      border: 1px solid var(--gold-line-soft); border-radius: var(--radius-lg); background: var(--navy-900);
    }
    .icon { width: 48px; height: 48px; stroke-width: 1.4; }
  }
</style>
