---
// "Our Network": Ruyat in the centre (hub) linked to its partner companies.
// Row on tablet/desktop (sizes from the prototype stage: 1120px / 770px), column on mobile.
import { getMain, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getMain(lang).partners;
const LOGOS = {
  'al-faisal': '/images/partners/alfaisal-logo-ar.svg',
  ruyat: '/logos/ruyat-logo-secondary-white.svg',
  'ruyat-shams': '/images/partners/ruyat-shams-1-full.svg',
} as const;
type Key = keyof typeof LOGOS;
const card = (key: Key) => ({ key, logo: LOGOS[key], ...t.items[key] });
---
<section class="partners" aria-label={t.label} data-section="partners">
  <div class="band b1" aria-hidden="true"></div>
  <div class="band b2" aria-hidden="true"></div>
  <div class="head">
    <div class="eyebrow-text">{t.eyebrow}</div>
    <h2 class="t-h1 title">{t.title}</h2>
  </div>
  <div class="stage">
    {[card('al-faisal')].map((c) => (
      <article class="partner">
        <h3 class="sr-only">{c.name}</h3>
        <img src={c.logo} alt={c.alt} />
      </article>
    ))}
    <div class="link to-start" aria-hidden="true"><span class="spark"></span></div>
    <div class="hub-wrap">
      <div class="ring" aria-hidden="true"></div>
      <div class="ring late" aria-hidden="true"></div>
      {[card('ruyat')].map((c) => (
        <article class="hub">
          <div class="hub-rib" aria-hidden="true"></div>
          <h3 class="sr-only">{c.name}</h3>
          <img src={c.logo} alt={c.alt} />
        </article>
      ))}
    </div>
    <div class="link to-end" aria-hidden="true"><span class="spark"></span></div>
    {[card('ruyat-shams')].map((c) => (
      <article class="partner">
        <h3 class="sr-only">{c.name}</h3>
        <img src={c.logo} alt={c.alt} />
      </article>
    ))}
  </div>
</section>

<style>
  .partners {
    position: relative; overflow: hidden; background: var(--surface-alt);
    display: flex; flex-direction: column; align-items: center; gap: var(--space-10);
    padding: var(--space-14) var(--space-5);
    /* Card geometry (mobile) */
    --side-w: 230px; --side-h: 240px; --side-pad: var(--space-6); --logo: 180px;
    --hub-w: 270px; --hub-h: 290px; --link: 56px; --flow: 36px; --spark: 20px;
  }
  .band {
    position: absolute; width: 200px; height: 12px; background: var(--rib-band);
    transform: rotate(calc(-45deg * var(--dir)));
  }
  .b1 { top: 22px; inset-inline-start: -58px; }
  .b2 { bottom: 22px; inset-inline-end: -58px; }

  .head { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-3); max-width: var(--container-text); text-align: center; }
  .eyebrow-text { color: var(--gold-700); font-size: 13px; font-weight: 700; line-height: 1.4; letter-spacing: 0.06em; text-transform: uppercase; }
  :lang(ar) .eyebrow-text { letter-spacing: 0; font-size: 15px; line-height: 1.5; }
  .title { margin: 0; color: var(--ink); }

  .stage { position: relative; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
  .partner, .hub {
    position: relative; box-sizing: border-box; border-radius: var(--radius-lg);
    display: flex; align-items: center; justify-content: center; padding: var(--side-pad);
  }
  .partner {
    width: var(--side-w); height: var(--side-h); background: var(--white);
    border: 1px solid var(--border); box-shadow: var(--shadow-card);
  }
  .partner img, .hub img { width: var(--logo); height: var(--logo); object-fit: contain; }
  .hub-wrap { position: relative; width: var(--hub-w); height: var(--hub-h); flex: none; }
  .hub {
    width: 100%; height: 100%; overflow: hidden; background: var(--navy-900);
    box-shadow: var(--shadow-hub); outline: 1px solid var(--gold-400); outline-offset: -8px;
  }
  .hub-rib {
    position: absolute; top: 18px; inset-inline-end: -40px; width: 140px; height: 12px;
    background: var(--rib-band); transform: rotate(calc(45deg * var(--dir)));
  }
  .ring {
    position: absolute; inset: 0; box-sizing: border-box; border-radius: var(--radius-lg);
    border: 2px solid var(--gold-400); opacity: 0;
    animation: pulse var(--duration-pulse) linear infinite;
  }
  .ring.late { animation-delay: calc(var(--duration-pulse) / 2); }

  /* Connector between cards (vertical on mobile), with a spark flowing out from the hub. */
  .link { position: relative; width: 2px; height: var(--link); flex: none; background: var(--gold-connector-y); }
  .link.to-end { background: linear-gradient(180deg, var(--gold-400) 0%, rgba(154, 104, 29, 0.35) 100%); }
  .spark {
    position: absolute; left: -1px; width: 4px; height: var(--spark); border-radius: 2px; opacity: 0;
    background: var(--gold-spark-y); box-shadow: var(--shadow-spark);
    animation: flow var(--duration-flow) linear infinite;
  }
  .to-start .spark { bottom: 0; --fx: 0px; --fy: calc(-1 * var(--flow)); }
  .to-end .spark { top: 0; --fx: 0px; --fy: var(--flow); }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.5; }
    25% { transform: scale(1.09); opacity: 0.32; }
    50% { transform: scale(1.135); opacity: 0.16; }
    75% { transform: scale(1.155); opacity: 0.05; }
    100% { transform: scale(1.16); opacity: 0; }
  }
  @keyframes flow {
    0% { transform: translate(0, 0); opacity: 0; }
    8% { transform: translate(calc(var(--fx) / 11), calc(var(--fy) / 11)); opacity: 1; }
    55%, 100% { transform: translate(var(--fx), var(--fy)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring, .spark { animation: none; opacity: 0; }
  }
  @media (max-width: 389px) { .stage { zoom: 0.91; } }
  @media (max-width: 359px) { .stage { zoom: 0.8; } }

  @media (min-width: 641px) {
    .partners {
      padding: var(--space-28) var(--space-8); gap: var(--space-14);
      --side-w: 220px; --side-h: 236px; --side-pad: var(--space-5); --logo: 170px;
      --hub-w: 250px; --hub-h: 270px; --link: 40px; --flow: 26px; --spark: 14px;
    }
    .band { width: 260px; height: 14px; }
    .b1 { top: 30px; inset-inline-start: -64px; }
    .b2 { bottom: 30px; inset-inline-end: -64px; }
    .head { gap: var(--space-3); }
    .stage { flex-direction: row; padding-block: 15px; }
    .hub-rib { width: 150px; }
    .link { width: var(--link); height: 2px; background: linear-gradient(calc(90deg * var(--dir)), rgba(154, 104, 29, 0.35) 0%, var(--gold-400) 100%); }
    .link.to-end { background: linear-gradient(calc(90deg * var(--dir)), var(--gold-400) 0%, rgba(154, 104, 29, 0.35) 100%); }
    .spark { top: -1px; left: auto; width: var(--spark); height: 4px; background: var(--gold-spark); }
    .to-start .spark { inset-inline-end: 0; bottom: auto; --fx: calc(-1 * var(--flow) * var(--dir)); --fy: 0px; }
    .to-end .spark { inset-inline-start: 0; --fx: calc(var(--flow) * var(--dir)); --fy: 0px; }
  }
  @media (min-width: 641px) and (max-width: 833px) { .stage { zoom: 0.91; } }

  @media (min-width: 1024px) {
    .partners {
      padding: 96px var(--space-10); gap: var(--space-16);
      --side-w: 300px; --side-h: 320px; --side-pad: 28px; --logo: 240px;
      --hub-w: 340px; --hub-h: 360px; --link: 90px; --flow: 66px; --spark: 24px;
    }
    .band { width: 320px; height: 18px; }
    .b1 { top: var(--space-10); inset-inline-start: -70px; }
    .b2 { bottom: var(--space-10); inset-inline-end: -70px; }
    .head { gap: 14px; }
    .stage { padding-block: 0; }
    .hub-rib { top: 22px; inset-inline-end: -46px; width: 180px; height: 14px; }
  }
  @media (min-width: 1024px) and (max-width: 1199px) { .stage { zoom: 0.84; } }
</style>
