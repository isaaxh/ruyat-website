---
// Language dropdown in the header. Keeps the user on the same page when switching language.
import { LOCALES, getMain, localizePath, stripLocale, type Locale } from '../i18n';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getMain(lang);
const rest = stripLocale(Astro.url.pathname);
---
<div class="lang" data-lang-switcher>
  <button type="button" class="lang-btn" aria-label={t.ui.language} aria-haspopup="listbox" aria-expanded="false" data-lang-toggle>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="globe"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20a14.5 14.5 0 0 0 0-20M2 12h20"></path></svg>
    <span class="latin">{lang.toUpperCase()}</span>
    <svg width="10" height="7" viewBox="0 0 12 8" fill="none" aria-hidden="true" class="chev"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <div class="lang-menu" role="listbox" hidden data-lang-menu>
    {LOCALES.map((l) => (
      <a
        role="option"
        class="lang-opt"
        href={localizePath(l, rest)}
        hreflang={l}
        aria-selected={l === lang ? 'true' : 'false'}
      >
        <span lang={l}>{getMain(l).meta.name}</span>
        <span class="code latin">{l.toUpperCase()}</span>
      </a>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-lang-toggle]')!;
    const menu = root.querySelector<HTMLElement>('[data-lang-menu]')!;
    const set = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      set(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
    root.addEventListener('lang:close', () => set(false));
  });
</script>

<style>
  .lang { position: relative; }
  .lang-btn {
    display: flex; align-items: center; gap: 6px; height: 40px; padding: 0 var(--space-3);
    border-radius: var(--radius-pill); border: 1px solid var(--gold-line-strong);
    background: var(--navy-glass); color: var(--white); cursor: pointer;
    font-size: 15px; font-weight: 700; line-height: 1.4; letter-spacing: 0;
  }
  .globe, .chev { color: var(--gold-400); flex: none; }
  .chev { display: none; }
  .lang-menu {
    position: absolute; top: calc(100% + var(--space-2)); inset-inline-end: 0; min-width: 160px; z-index: var(--z-dropdown);
    background: var(--white); border-radius: var(--radius-menu); box-shadow: var(--shadow-menu); padding: 6px;
  }
  .lang-opt {
    display: flex; justify-content: space-between; align-items: center; width: 100%; min-height: var(--size-tap);
    padding: 0 var(--space-3); box-sizing: border-box; border-radius: var(--space-2);
    color: var(--navy-900); text-decoration: none; text-align: start;
    font-size: 15px; font-weight: 700; line-height: 1.4;
  }
  .lang-opt:hover, .lang-opt[aria-selected='true'] { background: var(--ivory-100); color: var(--navy-900); }
  .lang-opt :lang(ar) { font-family: var(--font-arabic); }
  .lang-opt :lang(en) { font-family: var(--font-latin); }
  .code { font-size: 12px; font-weight: 700; color: var(--gold-700); }

  @media (min-width: 641px) {
    .lang-btn { height: var(--size-tap); padding: 0 14px; }
    .chev { display: block; }
    .lang-menu { min-width: 170px; }
  }
  @media (min-width: 1024px) {
    .lang-btn { gap: 7px; }
    .lang-menu { min-width: 180px; }
  }
</style>
