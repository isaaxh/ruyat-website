---
// Ivory call-to-action band: title, one line of copy and a navy button (button beside the text on desktop).
interface Props {
  title: string;
  text: string;
  cta: string;
  href: string;
}
const { title, text, cta, href } = Astro.props;
---
<section class="wrap cta-band" data-section="cta-band">
  <div class="box">
    <div>
      <h2 class="title">{title}</h2>
      <p class="text">{text}</p>
    </div>
    <a class="btn btn-navy" href={href}>{cta}</a>
  </div>
</section>

<style>
  .cta-band { padding: var(--space-8) var(--space-6) var(--space-12); }
  .box {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5);
    background: var(--surface-alt); border-radius: var(--radius-lg); padding: 26px 22px;
  }
  .title { margin: 0; color: var(--ink); font-size: 19px; font-weight: 800; line-height: 1.25; }
  .text { margin: var(--space-2) 0 0; color: var(--ink-muted); font-size: 16px; font-weight: 400; line-height: 1.6; }
  :lang(ar) .title { font-weight: 700; line-height: 1.45; }
  :lang(ar) .text { line-height: 1.8; }

  @media (min-width: 641px) {
    .cta-band { padding: 72px var(--space-8) var(--space-28); }
    /* Row that wraps: the button sits beside the copy when it fits, below it otherwise. */
    .box {
      padding: 44px var(--space-12); gap: var(--space-8);
      flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between;
    }
    .text { margin-top: var(--space-3); }
    .title { font-size: 26px; line-height: 1.3; }
    .text { font-size: 15px; }
  }
  @media (min-width: 1024px) {
    .cta-band { padding-inline: var(--space-10); }
  }
</style>
